    <!-- Typography -->
    <style name="TextAppearance.DiveSDK.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">32sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/diveSdkTextColorSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/diveSdkTextColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/diveSdkTextColorSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/diveSdkTextColorSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.DiveSDK.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.DiveSDK.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/diveSdkTextColorSecondary</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.DiveSDK.SmallComponent" parent="ShapeAppearance.DVS.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.DiveSDK.MediumComponent" parent="ShapeAppearance.DVS.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.DiveSDK.LargeComponent" parent="ShapeAppearance.DVS.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.DiveSDK.Button" parent="Widget.DVS.MaterialButton">
        <item name="android:textAppearance">@style/TextAppearance.DiveSDK.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimaryVariant</item>
    </style>
    <style name="Widget.DiveSDK.Button.Outlined" parent="Widget.DVS.OutlinedMaterialButton">
        <item name="android:textAppearance">@style/TextAppearance.DiveSDK.Button</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
